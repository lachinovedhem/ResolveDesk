# Copy to .env and fill in. .env is git-ignored — never commit real values.
#
# Everything here is also readable as a plain environment variable by the API, using the
# double-underscore form for nested keys (Ai__Chat__Provider, Auth__Jwt__SigningKey, …).

# ── Database (docker-compose) ─────────────────────────────────────────────────────────────────────
POSTGRES_DB=resolvedesk
POSTGRES_USER=resolvedesk
POSTGRES_PASSWORD=
# 5433 by default so it does not collide with a PostgreSQL you already run on 5432.
POSTGRES_PORT=5433

# ── API ───────────────────────────────────────────────────────────────────────────────────────────
DB_CONNECTION_STRING=Host=localhost;Port=5433;Database=resolvedesk;Username=resolvedesk;Password=
CORS_ALLOWED_ORIGINS=http://localhost:5173
ASPNETCORE_URLS=http://localhost:8080

# ── Authentication ────────────────────────────────────────────────────────────────────────────────
Auth__Enabled=false
Auth__Provider=Local
# Required once Auth__Enabled=true outside Development. At least 32 bytes:
#   openssl rand -base64 48
Auth__Jwt__SigningKey=

# Creates the first administrator on next start, once. Remove both after the first login.
Auth__BootstrapAdminEmail=
Auth__BootstrapAdminPassword=

# Sign-in methods are a set, not a choice — turn on as many as you want and the sign-in screen
# offers all of them. Provider (above) only says where a *password* is checked: Local or Ldap.
Auth__Methods__0=Password
# Auth__Methods__1=Passkey
# Auth__Methods__2=Oidc

# LDAP / Active Directory (only when Auth__Provider=Ldap)
# Auth__Ldap__Host=dc01.example.org
# Auth__Ldap__Port=636
# Auth__Ldap__BaseDn=DC=example,DC=org
# Auth__Ldap__BindDnTemplate={0}@example.org
# Auth__Ldap__CoordinatorGroup=CN=ResolveDesk-Coordinators
# Auth__Ldap__AdminGroup=CN=ResolveDesk-Admins

# Passkeys (WebAuthn). RelyingPartyId is the registrable domain; Origins must be the exact origins
# the browser reports, or every assertion is rejected.
# Auth__Passkey__RelyingPartyId=desk.example.org
# Auth__Passkey__Origins__0=https://desk.example.org

# Optional second factor after a password. Required=true refuses sign-in until an account enrols.
# Auth__Totp__Enabled=true
# Auth__Totp__Required=false

# Setup links for new accounts. The API returns the URL; it never sends mail itself.
# Auth__Invitations__LifetimeHours=48
# Auth__Invitations__BaseUrl=https://desk.example.org

# OpenID Connect, in two shapes.
#   Set ClientId and this API runs the code flow (PKCE) and issues its own token, so SSO works
#   beside a password and a passkey. Leave it empty and the SPA obtains a provider token instead,
#   which this API only validates.
# Auth__Oidc__Authority=https://id.example.org/realms/main
# Auth__Oidc__Audience=resolvedesk
# Auth__Oidc__ClientId=resolvedesk
# Auth__Oidc__ClientSecret=          # omit for a public client; PKCE is used either way
# Auth__Oidc__RedirectUri=https://desk.example.org/api/v1/auth/oidc/callback
# Auth__Oidc__PostLoginUrl=https://desk.example.org/auth/callback
# Auth__Oidc__RoleClaim=roles
# Auth__Oidc__CoordinatorRole=resolvedesk-coordinators
# Auth__Oidc__AdminRole=resolvedesk-admins

# ── AI ────────────────────────────────────────────────────────────────────────────────────────────
# Provider: None | Ollama | OpenAi | AzureOpenAi | Gemini
# OpenAi also covers LM Studio, vLLM, llama.cpp and OpenRouter — just point BaseUrl at them.
Ai__Enabled=true

Ai__Chat__Provider=Ollama
Ai__Chat__BaseUrl=http://localhost:11434
Ai__Chat__Model=qwen2.5-coder:7b
# Ai__Chat__ApiKey=            # hosted providers only; leave empty for local ones

Ai__Embedding__Provider=Ollama
Ai__Embedding__BaseUrl=http://localhost:11434
Ai__Embedding__Model=nomic-embed-text
# Must match the model's output width, and changing it means re-running the backfill.
Ai__Embedding__Dimensions=768

# ── MCP server ────────────────────────────────────────────────────────────────────────────────────
RESOLVEDESK_API_URL=http://localhost:8080
# RESOLVEDESK_API_TOKEN=       # required when Auth__Enabled=true
