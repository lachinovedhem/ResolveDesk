<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The API ships AOT; the tests do not need to, and the analyser would only add noise here. -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- The solution sets InvariantGlobalization, which makes every culture behave as invariant and
         so makes a comma-decimal locale impossible to reproduce. The tests opt out precisely so they
         *can* reproduce one: config parsing must not depend on the host's number format, whether or
         not a future consumer of these libraries keeps invariant mode on. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ResolveDesk.Core\ResolveDesk.Core.csproj" />
    <ProjectReference Include="..\..\src\ResolveDesk.Application\ResolveDesk.Application.csproj" />
    <ProjectReference Include="..\..\src\ResolveDesk.Infrastructure\ResolveDesk.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
